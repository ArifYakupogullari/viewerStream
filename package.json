{
  "name": "streambim-gaussian-splat-widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "StreamBIM widget that renders a Gaussian Splat (.ply) scene with camera synced to the StreamBIM viewport",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode devchannel --outDir dist/dev",
    "preview": "vite preview",
    "test:scene": "python3 tests/make_test_ply.py public/test-scenes/test-scene.ply",
    "test:e2e": "node tests/e2e/relay.mjs"
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "streambim-widget-api": "^3.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "playwright": "1.56.1",
    "vite": "^8.0.16"
  }
}
